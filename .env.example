DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/city_service_db
SECRET_KEY=replace_with_a_random_secret_at_least_32_characters

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
